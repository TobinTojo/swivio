# Supabase — required
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TMDB — recommended (falls back to mock movies if missing)
VITE_TMDB_KEY=

# Groq — free AI (https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# No extra env vars needed for Google Auth — configure in Supabase Dashboard
# (Authentication → Providers → Google). See README for setup steps.
